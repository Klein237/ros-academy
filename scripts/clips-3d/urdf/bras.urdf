<!-- Le bras de tri : un socle, une tourelle qui pivote, trois articulations dans un même plan
     (épaule, coude, poignet) et une pince à deux doigts. Bras tendu vers le haut quand tous
     les angles valent 0 ; un angle positif penche le bras vers l'avant (+x de la tourelle). -->
<robot name="bras">
  <material name="gris">
    <color rgba="0.35 0.38 0.42 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.1 1"/>
  </material>
  <material name="noir">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- Le socle, fixé à la table : le repère de référence du bras -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="gris"/>
    </visual>
  </link>
  <!-- La tourelle tourne autour de la verticale -->
  <joint name="base_rotation" type="revolute">
    <parent link="base_link"/>
    <child link="tourelle"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-3.141592653589793" upper="3.141592653589793" velocity="1.5"/>
  </joint>
  <link name="tourelle">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="epaule" type="revolute">
    <parent link="tourelle"/>
    <child link="bras"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.6" upper="1.6" velocity="1.5"/>
  </joint>
  <link name="bras">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.04 0.04 0.3"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="coude" type="revolute">
    <parent link="bras"/>
    <child link="avant_bras"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-2.2" upper="2.2" velocity="1.5"/>
  </joint>
  <link name="avant_bras">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry>
        <box size="0.035 0.035 0.25"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="poignet" type="revolute">
    <parent link="avant_bras"/>
    <child link="main"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.8" upper="1.8" velocity="1.5"/>
  </joint>
  <link name="main">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <link name="doigt_gauche">
    <visual>
      <origin xyz="0 0.005 0.03"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
      <material name="noir"/>
    </visual>
  </link>
  <link name="doigt_droit">
    <visual>
      <origin xyz="0 -0.005 0.03"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
      <material name="noir"/>
    </visual>
  </link>
  <joint name="pince" type="prismatic">
    <parent link="main"/>
    <child link="doigt_gauche"/>
    <origin xyz="0 0.005 0.04"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" lower="0" upper="0.03" velocity="0.1"/>
  </joint>
  <joint name="pince_miroir" type="prismatic">
    <parent link="main"/>
    <child link="doigt_droit"/>
    <origin xyz="0 -0.005 0.04"/>
    <axis xyz="0 -1 0"/>
    <limit effort="5" lower="0" upper="0.03" velocity="0.1"/>
    <mimic joint="pince"/>
  </joint>
  <!-- tool0 : le point de prise, entre les doigts, à l_poignet du poignet -->
  <joint name="outil" type="fixed">
    <parent link="main"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.1"/>
  </joint>
  <link name="tool0"/>
</robot>
