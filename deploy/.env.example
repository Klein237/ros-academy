DOMAIN=localhost
JWT_SECRET=remplacer-par-openssl-rand-hex-32
JUPYTERHUB_CRYPT_KEY=remplacer-par-openssl-rand-hex-32
HUB_ADMIN_TOKEN=remplacer-par-openssl-rand-hex-32
ROS_LAB_IMAGE=ros-lab:0.1.0
ACTIVE_SERVER_LIMIT=35
# Plage des réseaux des labs (un /28 par étudiant) ; ne doit recouvrir aucun réseau de l'hôte
LAB_SUBNETS=10.213.0.0/16
# Dossiers des étudiants limités à 1 Go (recommandé en production) : sudo scripts/preparer-hote.sh …
# puis décommenter ces deux lignes. Sans elles, volumes Docker sans limite de taille.
# LAB_HOMES_DIR=/srv/ros-academy/homes
# COMPOSE_FILE=docker-compose.yml:docker-compose.quotas.yml
IDLE_TIMEOUT_SECONDS=1200
# Dépôt Git où pousser le contenu publié (facultatif), ex. git@github.com:moi/ros-academy-content.git
CONTENT_GIT_REMOTE=
# docker (par défaut) : chaque publication teste les modules modifiés. off : développement uniquement.
MODULE_TESTS=docker
# --- Service Comptes
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-32
# Adresses (séparées par des virgules) qui ouvrent l'éditeur et le tableau de bord formateur
ADMIN_EMAILS=
# Note finale minimale (sur 20) pour obtenir un certificat
CERTIFICAT_NOTE_MIN=10
# Envoi des liens de connexion et des alertes. Sans SMTP_HOST, aucun e-mail : le lien est écrit dans
# `docker compose logs comptes`. Exemples (tester ensuite : docker compose exec comptes python -m academy_comptes.mail vous@exemple.fr) :
#   Gmail     : SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  SMTP_USER=vous@gmail.com  SMTP_PASSWORD=<mot de passe d'application>
#               (compte Google → Sécurité → validation en deux étapes → Mots de passe des applications)
#   Brevo     : SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<identifiant SMTP> SMTP_PASSWORD=<clé SMTP>
#   OVH       : SMTP_HOST=ssl0.ovh.net       SMTP_PORT=465  SMTP_USER=contact@votre-domaine.fr SMTP_PASSWORD=…
# SMTP_FROM : l'expéditeur affiché, une adresse que ce serveur a le droit d'utiliser (ex. RoboForge <vous@gmail.com>).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Test sur votre machine sans SMTP : le lien de connexion s'affiche sur la page au lieu d'être envoyé.
# Sans effet dès que SMTP_HOST est rempli ou que DOMAIN n'est pas localhost.
CONNEXION_LIEN_A_L_ECRAN=1
# Connexion GitHub (facultatif) : OAuth App, URL de retour https://<domaine>/connexion/github/retour
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Connexion Google (facultatif) : identifiants OAuth « application Web », URL de retour https://<domaine>/connexion/google/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Abonnement pro (facultatif) : les trois valeurs sont nécessaires, sinon l'abonnement n'est pas proposé.
# Clé secrète (sk_live_… ou sk_test_…), secret du webhook (whsec_…), identifiant du prix mensuel (price_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# --- Journaux et alertes
# Grafana (/admin/journaux/) : accès par la session de l'éditeur ; ce mot de passe n'est jamais utilisé
# pour se connecter (formulaire désactivé) mais doit être fort.
GRAFANA_ADMIN_PASSWORD=remplacer-par-openssl-rand-hex-32
# Seuils d'alerte en % (e-mail aux ADMIN_EMAILS par le SMTP ci-dessus)
VEILLE_SEUIL_CPU=80
VEILLE_SEUIL_MEMOIRE=80
VEILLE_SEUIL_DISQUE=80
# --- Sauvegardes (scripts/sauvegarder.sh, tous les jours à 3 h 17 après installer-serveur.sh)
# Nombre de jours gardés ; aussi annoncé aux utilisateurs dans la politique de confidentialité.
SAUVEGARDE_JOURS=14
# --- Mentions légales (pages /mentions-legales et /confidentialite) : obligatoires en ligne
EDITEUR_NOM=
EDITEUR_ADRESSE=
# Contact pour les demandes des utilisateurs (par défaut : la première adresse de ADMIN_EMAILS)
EDITEUR_CONTACT=
# Hébergeur : nom, adresse et téléphone (ex. Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne)
HEBERGEUR=
