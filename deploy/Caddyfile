{$DOMAIN} {
	encode zstd gzip

	redir /lab /lab/

	# Lab UI : fichiers statiques, même origine que le Hub
	handle_path /lab/* {
		root * /srv/lab-ui
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://{http.request.host}; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'none'; form-action 'self'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control no-cache
		file_server
	}

	# Serveurs étudiants : même origine que le Lab UI. Un étudiant peut y servir
	# n'importe quel fichier (API fichiers, jupyter-server-proxy) ; la CSP sandbox
	# donne à ces documents une origine opaque : pas d'accès aux cookies du Hub,
	# à /hub/lab_token ni aux autres serveurs. Le Lab UI n'y charge que de l'API.
	@userserver path /user/*
	header @userserver {
		>Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'"
		>X-Content-Type-Options nosniff
	}

	# Le cookie de session de Comptes ne part jamais vers le Hub ni vers les serveurs
	# étudiants (un étudiant contrôle le serveur qui reçoit les requêtes /user/<nom>/).
	handle /hub/* {
		reverse_proxy hub:8000 {
			header_up Cookie "(^|;\s*)academy_session=[^;]*" ""
		}
	}

	handle /user/* {
		reverse_proxy hub:8000 {
			header_up Cookie "(^|;\s*)academy_session=[^;]*" ""
		}
	}

	# Routes internes : correction du QCM, indices, explication (Contenus) et quota
	# demandé par le Hub (Comptes). Le navigateur passe par Comptes, qui applique les règles.
	@interne {
		path_regexp ^/api/(comptes/interne/|contenus/modules/[^/]+/(indices/|explication))
	}
	@qcm_interne {
		method POST
		path_regexp ^/api/contenus/modules/[^/]+/qcm
	}
	handle @interne {
		respond 404
	}
	handle @qcm_interne {
		respond 404
	}

	# Connexion, compte, accès au lab, progression et notes
	@comptes path /connexion /connexion/* /deconnexion /compte /compte/* /api/comptes/* /static/comptes/*
	handle @comptes {
		reverse_proxy comptes:8300
	}

	# Site des formations, API des modules et éditeur d'administration
	handle {
		reverse_proxy contenus:8200
	}
}
